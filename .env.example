# Copy to .env and fill in your own credentials. Never commit .env.
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# OpenAI: used to draft scripts, create narration, and generate a visual.
OPENAI_API_KEY=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional: maximum daily upload target. YouTube quota/account limits still apply.
DAILY_UPLOAD_TARGET=5
TIMEZONE=America/New_York
